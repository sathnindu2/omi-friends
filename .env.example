# Copy this file to ".env" and change values if you need to.
# None of these values are secret. Never put passwords or API keys in client code.

# Port the game server listens on (Render/Railway set this automatically).
PORT=3001

# "production" when deployed. Render/Railway usually set this for you.
NODE_ENV=development

# Allowed browser origins for Socket.IO (comma separated).
# Only needed when the website and the game server are on DIFFERENT addresses.
# Leave empty when one URL serves both (recommended).
# Example: CLIENT_ORIGIN=https://omi-friends.onrender.com,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when running behind a proxy/load balancer (Render, Railway) so
# rate limits see the real visitor IP address.
TRUST_PROXY=1

# How long (milliseconds) a disconnected player keeps their seat during a game
# before the other players may abandon the game. Default: 3 minutes.
RECONNECT_TIMEOUT_MS=180000

# How long (ms) a disconnected player keeps their seat in the lobby. Default: 2 minutes.
LOBBY_RECONNECT_TIMEOUT_MS=120000

# Rooms with nobody connected are deleted after this long (ms). Default: 30 minutes.
ROOM_IDLE_TIMEOUT_MS=1800000

# Pause (ms) after the 4th card so everyone can see who won the trick. Default 1600.
TRICK_REVIEW_MS=1600

# Pause (ms) on the hand-result screen before the next hand is dealt. Default 9000.
HAND_RESULT_MS=9000

# --- Client (Vite) ---
# Only set this if the game server lives on a different URL than the website.
# VITE_SERVER_URL=https://your-game-server.onrender.com
